          "usage": "hsl(var(--primary-foreground))"
        },
        {
          "name": "--secondary",
          "role": "secondary",
          "usage": "hsl(var(--secondary))"
        },
        {
          "name": "--secondary-foreground",
          "role": "secondary-foreground",
          "usage": "hsl(var(--secondary-foreground))"
        },
        {
          "name": "--accent",
          "role": "accent",
          "usage": "hsl(var(--accent))"
        },
        {
          "name": "--accent-foreground",
          "role": "accent-foreground",
          "usage": "hsl(var(--accent-foreground))"
        },
        {
          "name": "--muted",
          "role": "muted",
          "usage": "hsl(var(--muted))"
        },
        {
          "name": "--muted-foreground",
          "role": "muted-foreground",
          "usage": "hsl(var(--muted-foreground))"
        },
        {
          "name": "--card",
          "role": "card",
          "usage": "hsl(var(--card))"
        },
        {
          "name": "--card-foreground",
          "role": "card-foreground",
          "usage": "hsl(var(--card-foreground))"
        },
        {
          "name": "--border",
          "role": "border",
          "usage": "hsl(var(--border))"
        },
        {
          "name": "--ring",
          "role": "ring",
          "usage": "hsl(var(--ring))"
        },
        {
          "name": "--popover",
          "role": "popover",
          "usage": "hsl(var(--popover))"
        },
        {
          "name": "--popover-foreground",
          "role": "popover-foreground",
          "usage": "hsl(var(--popover-foreground))"
