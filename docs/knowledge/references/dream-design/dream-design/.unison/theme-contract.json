    {
      "id": "typography",
      "label": "Typography",
      "tokens": [
        {
          "name": "--ut-type-hero",
          "role": "home-hero headline size — one modular step above display",
          "usage": "text-[length:var(--ut-type-hero)] — or <Heading size=\"hero\">"
        },
        {
          "name": "--ut-type-display",
          "role": "hero / page-title size",
          "usage": "text-[length:var(--ut-type-display)]"
        },
        {
          "name": "--ut-type-title",
          "role": "section-heading size",
          "usage": "text-[length:var(--ut-type-title)]"
        },
        {
          "name": "--ut-type-lead",
          "role": "lead paragraph size",
          "usage": "text-[length:var(--ut-type-lead)]"
        },
        {
          "name": "--ut-heading-tracking",
          "role": "heading letter-spacing",
          "usage": "tracking-[var(--ut-heading-tracking)]"
        },
        {
          "name": "--ut-heading-transform",
          "role": "heading text-transform",
          "usage": "[text-transform:var(--ut-heading-transform)]"
        },
        {
          "name": "--ut-measure",
          "role": "optimal body line length",
          "usage": "max-w-[var(--ut-measure)]"
        },
        {
          "name": "--ut-font-display-stack",
          "role": "display font stack",
          "usage": "font-[var(--ut-font-display-stack)] — already applied to headings globally"
        },
        {
          "name": "--ut-font-sans-stack",
          "role": "body font stack",
          "usage": "applied globally; do not re-declare"
        },
        {
          "name": "--ut-weight-display",
          "role": "display weight",
          "usage": "font-[number:var(--ut-weight-display)]"
        },
        {
          "name": "--ut-weight-body",
          "role": "body weight",
          "usage": "font-[number:var(--ut-weight-body)]"
        },
        {
          "name": "--ut-display-leading",
          "role": "display line-height",
          "usage": "leading-[var(--ut-display-leading)]"
        },
        {
          "name": "--ut-eyebrow-tracking",
          "role": "eyebrow letter-spacing",
          "usage": "tracking-[var(--ut-eyebrow-tracking)]"
        },
        {
          "name": "--ut-eyebrow-transform",
          "role": "eyebrow text-transform",
          "usage": "[text-transform:var(--ut-eyebrow-transform)]"
        },
        {
          "name": "--font-heading",
          "role": "heading font family",
          "usage": "font-heading"
        },
        {
          "name": "--font-body",
          "role": "body font family",
          "usage": "font-body"
        }
      ]
    },
    {
      "id": "scale",
      "label": "Scale",
      "tokens": [
        {
          "name": "--ut-type-ratio",
          "role": "modular type-scale ratio",
          "usage": "informational — drives the size tokens below"
        }
      ]
    },
    {
      "id": "spacing",
      "label": "Spacing rhythm",
      "tokens": [
        {
          "name": "--ut-rhythm-space",
          "role": "vertical space between sections",
          "usage": "py-[var(--ut-rhythm-space)] — or use <Section>, which applies it"
        },
        {
          "name": "--ut-density",
          "role": "density name",
          "usage": "informational"
        },
        {
          "name": "--ut-grid-gap",
          "role": "gap between grid cells",
          "usage": "gap-[var(--ut-grid-gap)] — or use <Grid>"
        },
        {
          "name": "--ut-block-gap",
          "role": "gap between content blocks",
          "usage": "gap-[var(--ut-block-gap)]"
        },
        {
          "name": "--ut-card-padding",
          "role": "internal card padding",
          "usage": "p-[var(--ut-card-padding)] — or use <Card>/<Panel>"
        },
        {
          "name": "--ut-inline-gutter",
          "role": "horizontal page gutter",
          "usage": "px-[var(--ut-inline-gutter)] — or use <Container>"
        },
        {
          "name": "--ut-stack-gap",
          "role": "gap inside a vertical stack",
          "usage": "gap-[var(--ut-stack-gap)] — or use <Stack>"
        }
      ]
    },
