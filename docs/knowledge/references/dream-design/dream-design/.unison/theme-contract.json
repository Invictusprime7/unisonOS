{
  "version": "1.0",
  "artDirectionPackId": "cinematic-portfolio",
  "artDirectionName": "Cinematic Portfolio",
  "artDirectionDescription": "Full-bleed imagery, inspection-led motion, portrait-weighted media.",
  "artDirectionFamilyId": "editorial",
  "artDirectionQualifiedPackId": "bold.cinematic-portfolio",
  "themePresetId": "bold",
  "signature": {
    "typeScaleRatio": 1.25,
    "headingTransform": "none",
    "rhythm": "expansive",
    "density": "gallery",
    "surface": "flat",
    "gradient": "ink-fade",
    "heroLayout": "full-bleed",
    "heroAlign": "start",
    "pill": "underline-caps",
    "entrance": "slow-pan",
    "motionProfile": "gallery-inspection",
    "interactionProfile": "image-lightbox",
    "mediaTreatment": "full-bleed",
    "accentPolicy": "radial-bloom"
  },
  "groups": [
    {
