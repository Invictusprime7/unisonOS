    "automation:dev": "concurrently \"npm run dev\" \"npm run inngest:dev\"",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "build:dev": "vite build --mode development",
    "deploy": "node scripts/check-clean-git-tree.mjs && vercel --prod",
    "deploy:preview": "vercel",
    "deploy:watch": "powershell -ExecutionPolicy Bypass -File ./scripts/vercel-deploy.ps1 -Watch -Production",
    "dev": "vite",
    "inngest:deploy": "npx inngest-cli@latest deploy",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest",
    "lint": "eslint .",
    "lint:app-builder-authority": "node scripts/lint-app-builder-authority.mjs",
    "lint:canonical-vfs-writes": "node scripts/lint-canonical-vfs-writes.mjs",
    "lint:catalog-contracts": "node scripts/lint-catalog-contracts.mjs",
    "lint:pipeline-bypass": "node scripts/lint-pipeline-bypass.mjs",
    "lint:single-source-of-truth": "node scripts/lint-single-source-of-truth.mjs",
    "prebuild": "npm run recipes:check",
    "preview": "vite preview",
    "recipes:build": "node scripts/build-stylex-recipes.mjs",
    "recipes:check": "node scripts/build-stylex-recipes.mjs --check",
    "supabase:check": "powershell -ExecutionPolicy Bypass -File ./scripts/supabase-auto-update.ps1 -CheckOnly",
    "supabase:deploy": "powershell -ExecutionPolicy Bypass -File ./scripts/supabase-auto-update.ps1 -Force",
    "supabase:sync-secrets": "powershell -ExecutionPolicy Bypass -File ./scripts/supabase-auto-update.ps1 -SyncSecrets",
    "supabase:update": "powershell -ExecutionPolicy Bypass -File ./scripts/supabase-auto-update.ps1",
    "supabase:watch": "powershell -ExecutionPolicy Bypass -File ./scripts/supabase-auto-update.ps1 -Watch",
    "test:edge": "npx --yes deno@2 test --allow-all --no-check supabase/functions/",
    "type-check": "tsc --build --noEmit",
    "unison": "node scripts/unison.mjs",
    "test": "vitest run --reporter=default",
    "test:watch": "vitest",
    "verify": "npm run type-check && npm run lint && npm run lint:pipeline-bypass && npm run lint:canonical-vfs-writes && npm run lint:single-source-of-truth && npm test",
    "ci": "npm run verify && npm run build"
  },
